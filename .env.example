# PostgreSQL (Supabase : Settings → Database → Connection string, mode "Transaction pooler" ou direct)
DATABASE_URL=postgres://jm:jm@localhost:5432/jm
# Mettre "true" si la base exige SSL (Supabase, Neon, etc.)
DATABASE_SSL=false

# URL publique du site (SEO, sitemap, liens de paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dossier des images téléversées (monter un volume persistant en production)
UPLOAD_DIR=./uploads

# --- Paiement en ligne (optionnel) ------------------------------------------
# CinetPay (Orange Money, MTN MoMo, Moov, Wave, cartes) — https://cinetpay.com
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
